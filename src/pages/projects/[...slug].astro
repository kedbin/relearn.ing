---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import AudioPlayer from '../../components/AudioPlayer';
import { getProjects, formatDate, readingTime } from '../../lib/content';
import { splitTitle, demoLabel } from '../../components/projects/projectMeta';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, others: projects.filter((p) => p.id !== project.id).slice(0, 3) },
  }));
}

const { project, others } = Astro.props;
const { Content } = await render(project);
const { name, subtitle } = splitTitle(project.data.title);
const { date, description, techStack, repoUrl, demoUrl, audioUrl } = project.data;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout title={name} description={description} type="article">
  <article class="pb-8 pt-10 md:pt-16">
    <header class="wrap-narrow">
      <nav aria-label="Breadcrumb" class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
        <a href="/projects/" class="transition-colors hover:text-accent">Projects</a>
        <span class="px-1.5 text-faint" aria-hidden="true">/</span>
        <span class="text-text" aria-current="page">{name}</span>
      </nav>

      <h1 class="h-display mt-8 text-5xl md:text-7xl" transition:name={`project-${project.id}`}>{name}</h1>
      {subtitle && <p class="h-title mt-3 text-xl text-text/80 md:text-2xl">{subtitle}</p>}
      <p class="dek mt-6 text-lg leading-relaxed md:text-xl">{description}</p>

      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-y py-5 text-sm sm:grid-cols-[auto_auto_1fr_auto]">
        <div>
          <dt class="label !text-faint">Shipped</dt>
          <dd class="num mt-1.5 text-xs text-text">{formatDate(date)}</dd>
        </div>
        <div class="text-right sm:text-left">
          <dt class="label !text-faint">Read</dt>
          <dd class="num mt-1.5 text-xs text-text">{readingTime(project.body)} min</dd>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <dt class="label !text-faint">Stack</dt>
          <dd class="mt-1.5 font-mono text-xs leading-relaxed text-text">{techStack.join(' · ')}</dd>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <dt class="label !text-faint">Links</dt>
          <dd class="mt-0.5 flex gap-4">
            {repoUrl && <a href={repoUrl} {...ext} class="link inline-flex min-h-8 items-center">Repo ↗</a>}
            {demoUrl && <a href={demoUrl} {...ext} class="link inline-flex min-h-8 items-center whitespace-nowrap">{demoLabel(demoUrl)} ↗</a>}
          </dd>
        </div>
      </dl>

      {audioUrl && (
        <div class="mt-8">
          <AudioPlayer src={audioUrl} title="Listen to the write-up" client:visible />
        </div>
      )}
    </header>

    <div class="wrap-narrow mt-12 md:mt-14">
      <div class="prose-lab">
        <Content />
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="wrap mt-24 md:mt-32" aria-labelledby="others-h">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="label"><i class="sq"></i>Workbench</p>
          <h2 id="others-h" class="h-display mt-4 text-4xl md:text-5xl">Other <em>projects</em></h2>
        </div>
        <a href="/projects/" class="link hidden text-sm sm:inline">All projects →</a>
      </div>
      <div class="border-b">
        {others.map((p) => {
          const t = splitTitle(p.data.title);
          return (
            <a href={`/projects/${p.id}/`} class="index-row group grid grid-cols-[3.5rem_1fr_auto] items-baseline gap-x-4 px-2 py-5 md:grid-cols-[5rem_1fr_14rem_2rem] md:gap-x-6 md:px-3 md:py-6">
              <span class="num text-xs text-faint transition-colors group-hover:text-accent">{formatDate(p.data.date, { year: 'numeric' })}</span>
              <span class="min-w-0">
                <span class="row-title h-title block text-[1.075rem] transition-colors md:text-[1.2rem]">{t.name}</span>
                {t.subtitle && <span class="dek mt-1 block text-[0.925rem]">{t.subtitle}</span>}
              </span>
              <span class="hidden truncate text-right font-mono text-[11px] uppercase tracking-[0.08em] text-faint md:block">{p.data.techStack.slice(0, 2).join(' · ')}</span>
              <span class="row-arrow self-center text-right text-faint" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>
  )}
</Layout>
