---
import Layout from '../../layouts/Layout.astro';
import ProjectRow from '../../components/projects/ProjectRow.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const [lead, ...rest] = projects;
---

<Layout
  title="Projects"
  description="Publishing pipelines, voice tools and coding agents, with source code and implementation notes."
>
  <section class="wrap pb-12 pt-14 md:pb-16 md:pt-24">
    <p class="label reveal"><i class="sq"></i>Projects</p>
    <h1 class="h-display reveal mt-7 max-w-5xl text-[3.2rem] sm:text-7xl md:text-[5.8rem]" style="--d:1">
      Tools and systems
    </h1>
    <p class="dek reveal mt-8 max-w-[36rem] text-lg leading-relaxed md:text-xl" style="--d:2">
      Publishing pipelines, voice tools and coding agents, with source code and implementation notes.
    </p>
  </section>

  <section class="wrap" aria-label="All projects">
    <div class="border-b">
      {lead && <ProjectRow project={lead} lead />}
      {rest.map((p) => <ProjectRow project={p} />)}
    </div>
  </section>
</Layout>
