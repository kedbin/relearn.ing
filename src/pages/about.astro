---
import Layout from '../layouts/Layout.astro';
import Section from '../components/about/Section.astro';
import Timeline from '../components/about/Timeline.astro';
import CertList from '../components/about/CertList.astro';
import Toolbox from '../components/about/Toolbox.astro';
import {
  profile, now, nowUpdated, stats, experience, certs, skills, principles, vanPhoto,
} from '../data/about';

const L = profile.links;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout
  title="About"
  description="Kim Binasoy is a Toronto-based AI automation engineer at Accenture who went from medical technology to cloud. relearn.ing is his public lab notebook."
>
  <!-- ─────────── Intro ─────────── -->
  <section class="wrap pb-6 pt-14 md:pt-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_360px] lg:gap-20">
      <div>
        <p class="label reveal"><i class="sq"></i>About · {profile.location}</p>
        <h1 class="h-display reveal mt-7 text-[3.1rem] sm:text-7xl md:text-[5.6rem]" style="--d:1">
          Hi, I'm Kim. I automate things, including, lately, <em>myself</em><span class="text-accent">.</span>
        </h1>

        <div class="reveal mt-10 max-w-[38rem] space-y-5 text-lg leading-relaxed text-text/85 md:text-[1.2rem]" style="--d:2">
          <p>
            By day I'm an AI automation engineer at Accenture in Toronto. I build Playwright pipelines and LLM agents
            that write, run and review tests, so the people on my team can spend their time on judgement
            instead of busywork.
          </p>
          <p>
            I didn't start in tech. I trained in medical technology in Manila, running specimens through protocols
            in a clinical lab, then rebuilt my career from scratch in cloud operations, QA and, eventually, AI. That lab
            habit stuck: write it down, control the variables, report what actually happened.
          </p>
          <p>
            relearn.ing exists because of the engineer's paradox. I build reliable, fault-tolerant systems for clients, but
            my own operating system was a mess of half-started projects and productivity apps that only added friction.
            So I started debugging sleep, focus and decisions like production infrastructure, and logging every
            experiment here, in public.
          </p>
        </div>

        <ul class="reveal mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm" style="--d:3">
          <li><a href={L.resume.href} {...ext} class="btn-solid">{L.resume.label} <span aria-hidden="true">↗</span></a></li>
          {[L.portfolio, L.github, L.linkedin].map((l) => (
            <li><a href={l.href} {...ext} class="link inline-flex min-h-10 items-center">{l.label}<span class="ml-1 text-faint" aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>

      <figure class="reveal self-start lg:mt-4" style="--d:2">
        <div class="overflow-hidden rounded-[3px] bg-surface2">
          <img
            src={profile.photo.src}
            alt={profile.photo.alt}
            width="900"
            height="1342"
            class="aspect-[4/5] w-full object-cover object-[center_22%] dark:brightness-[0.92]"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
          <span>Fig. 1 · Kim Binasoy</span><span>{profile.photo.caption}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ─────────── Readout ─────────── -->
  <section class="wrap mt-16 md:mt-24" aria-label="Work in numbers">
    <div class="border-y">
      <p class="label pt-6">Readout <span class="text-faint">· from the day job and this site</span></p>
      <dl class="grid divide-y sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {stats.map((s, i) => (
          <div class:list={['flex flex-col-reverse py-6 sm:py-8', i > 0 && 'sm:pl-8', i < stats.length - 1 && 'sm:pr-8']}>
            <dt class="mt-3 max-w-[24ch] text-sm leading-snug text-muted">{s.label}</dt>
            <dd class="num text-5xl tracking-tight text-text md:text-6xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─────────── Now ─────────── -->
  <Section id="now" label="Now" note={`Updated ${nowUpdated}`}>
    <Fragment slot="title">What I'm <em>on</em> right now</Fragment>
    <dl class="border-b">
      {now.map((n) => (
        <div class="grid gap-x-8 gap-y-1 border-t py-5 sm:grid-cols-[8rem_1fr]">
          <dt class="label pt-1">{n.label}</dt>
          <dd class="text-[1.05rem] leading-relaxed text-text/90">{n.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- ─────────── Experience ─────────── -->
  <Section id="experience" label="Experience">
    <Fragment slot="title">From the lab bench to the <em>build</em> pipeline</Fragment>
    <Timeline items={experience} />
  </Section>

  <!-- ─────────── Off the clock ─────────── -->
  <section class="wrap mt-24 md:mt-32" aria-label="Off the clock">
    <figure class="grid items-end gap-6 lg:grid-cols-[1fr_17rem] lg:gap-16">
      <div class="overflow-hidden rounded-[3px] bg-surface2">
        <img
          src={vanPhoto.src}
          alt={vanPhoto.alt}
          width="1400"
          height="953"
          class="aspect-[16/9] w-full object-cover object-[center_60%] dark:brightness-[0.9]"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="lg:pb-1">
        <p class="label"><i class="sq"></i>Fig. 2 · Off the clock</p>
        <p class="mt-4 font-serif text-lg italic leading-relaxed text-text/85">{vanPhoto.caption}</p>
      </figcaption>
    </figure>
  </section>

  <!-- ─────────── Certifications ─────────── -->
  <Section id="certs" label="Certifications">
    <Fragment slot="title">Paper <em>trail</em></Fragment>
    <CertList certs={certs} />
  </Section>

  <!-- ─────────── Toolbox ─────────── -->
  <Section id="toolbox" label="Toolbox">
    <Fragment slot="title">What's on the <em>bench</em></Fragment>
    <Toolbox groups={skills} />
  </Section>

  <!-- ─────────── Principles ─────────── -->
  <Section id="principles" label="How this notebook runs">
    <Fragment slot="title">Four <em>rules</em></Fragment>
    <ol class="grid gap-x-10 border-b sm:grid-cols-2">
      {principles.map((p, i) => (
        <li class="border-t py-7">
          <span class="num text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h-title mt-3 text-xl">{p.title}</h3>
          <p class="mt-2 max-w-[44ch] leading-relaxed text-text/80">{p.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ─────────── Contact ─────────── -->
  <section class="wrap mt-24 md:mt-32" aria-labelledby="contact-h">
    <div class="border-t pt-12 md:pt-16">
      <p class="label"><i class="sq"></i>Contact</p>
      <h2 id="contact-h" class="h-display mt-5 max-w-4xl text-5xl md:text-7xl">
        Say <em>hello</em>.
      </h2>
      <p class="dek mt-6 max-w-xl text-lg leading-relaxed">
        Questions about an entry, automation work, or a career change of your own? I read everything.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href={`mailto:${profile.email}`} class="btn-solid">{profile.email}</a>
        <a href={L.linkedin.href} {...ext} class="btn-line">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={L.threads.href} {...ext} class="btn-line">Threads <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Layout>
