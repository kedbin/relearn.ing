---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/about';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout
  title="About"
  description="Meet Kim Binasoy, the Toronto-based author of relearn.ing, and explore the projects behind the journal."
>
  <section class="wrap pb-20 pt-12 md:pb-28 md:pt-20" aria-labelledby="about-h">
    <div class="grid gap-y-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-x-24 lg:gap-y-0">
      <div class="lg:col-start-1">
        <p class="label reveal"><i class="sq" aria-hidden="true"></i>About</p>
        <h1 id="about-h" class="h-display reveal mt-6 text-[3.5rem] leading-[0.95] sm:text-7xl md:text-[5.75rem]" style="--d:1">
          {profile.name}
        </h1>
        <p class="mt-6 max-w-[34ch] font-serif text-2xl leading-snug md:text-3xl">I build software in Toronto. Here I write about the tools I use, from Excel scripts to teams of coding agents.</p>
      </div>

      <figure class="reveal w-[11rem] self-start sm:w-[14rem] lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-2 lg:w-full" style="--d:2">
        <div class="overflow-hidden rounded-[2px] bg-surface2">
          <img
            src={profile.photo.src}
            alt={profile.photo.alt}
            width={profile.photo.width}
            height={profile.photo.height}
            class="aspect-[4/5] w-full object-cover object-[center_30%] dark:brightness-[0.9]"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
          {profile.location}
        </figcaption>
      </figure>

      <div class="lg:col-start-1 lg:row-start-2">
        <div class="grid gap-6 border-y py-6 sm:grid-cols-2 lg:mt-10">
          <div class="flex flex-col items-start"><h2 class="label">Writing</h2><a class="link mt-3 inline-block" href="/journal/">Browse the journal →</a></div>
          <div class="flex flex-col items-start"><h2 class="label">Code</h2><a class="link mt-3 inline-block" href={profile.source.href} {...ext}>Source for this site ↗</a></div>
        </div>

        <div class="reveal mt-12 md:mt-16" style="--d:3">
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Portfolio & résumé</p>
          <a href={profile.portfolio.href} {...ext} class="who group mt-3 inline-flex items-baseline gap-3 font-display text-[2.75rem] leading-none tracking-tight text-text transition-colors duration-200 hover:text-accent md:text-[3.75rem]">
            <span class="who-u">{profile.portfolio.label}</span>
            <span class="text-[0.55em] text-accent transition-transform duration-200 ease-out-quint group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
          <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
            {profile.social.map((l) => (
              <li>
                <a href={l.href} {...ext} class="inline-flex min-h-10 items-center text-muted transition-colors hover:text-text">
                  {l.label}<span class="ml-1 text-faint" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .who-u {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    text-decoration-color: rgb(var(--text) / 0.25);
    transition: text-decoration-color 200ms;
  }
  .who:hover .who-u { text-decoration-color: rgb(var(--accent)); }
</style>
