---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import AudioPlayer from '../../components/AudioPlayer';
import ReadingProgress from '../../components/article/ReadingProgress.astro';
import SeriesNav from '../../components/article/SeriesNav.astro';
import Highlights from '../../components/article/Highlights.astro';
import Toc from '../../components/article/Toc.astro';
import LiteYouTube from '../../components/article/LiteYouTube.astro';
import EntryFooter from '../../components/article/EntryFooter.astro';
import { tocHeadings, shouldShowToc, bodyEmbedsVideo } from '../../components/article/article-utils';
import {
  getEntries, entryNo, domainOf, topicOf, domainDotClass, readingTime, formatDate, relatedEntries, neighbours,
  type Entry,
} from '../../lib/content';
import { FDE_WORKSHOP_SERIES, visibleFdeSeries } from '../../lib/journal-visibility';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

interface Props { entry: Entry; all: Entry[] }
const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);

const d = entry.data;
const domain = domainOf(d.category);
const minutes = readingTime(entry.body);

const isFde = FDE_WORKSHOP_SERIES.some((s) => s.id === entry.id);
const series = isFde ? visibleFdeSeries(all.map((e) => e.id)) : [];

const toc = tocHeadings(headings);
const showToc = shouldShowToc(toc);

const showVideo = !!d.youtube_video_id && !bodyEmbedsVideo(entry.body, d.youtube_video_id);
const { prev, next } = neighbours(entry, all);
const related = relatedEntries(entry, all, 3);
---

<Layout title={d.title} description={d.summary} type="article">
  <ReadingProgress />

  <article class="pb-8 pt-10 md:pt-16" data-entry={entry.id}>
    <!-- ───────── Header ───────── -->
    <header class="wrap-narrow">
      <nav aria-label="Breadcrumb" class="reveal">
        <ol class="num flex items-center gap-2 text-xs text-muted">
          <li><a href="/journal/" class="transition-colors hover:text-accent">Journal</a></li>
          <li aria-hidden="true" class="text-faint">/</li>
          <li aria-current="page"><span class="text-accent">№</span> {entryNo(entry.id)}</li>
        </ol>
      </nav>

      {d.draft && (
        <p class="label mt-8 !text-accent reveal" role="note">
          <i class="sq"></i>Preview draft · not in the production build. Video and social publishing pending approval.
        </p>
      )}

      <p class="reveal mt-10 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13px] text-muted md:mt-14" style="--d: 1">
        <span class="inline-flex items-center gap-2"><span class={`dot ${domainDotClass(domain)}`}></span>{topicOf(d.category)}</span>
        <span class="text-faint" aria-hidden="true">·</span>
        <time class="num" datetime={d.date}>{formatDate(d.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        <span class="text-faint" aria-hidden="true">·</span>
        <span class="num">{minutes} min read</span>
        {d.audioUrl && (<><span class="text-faint" aria-hidden="true">·</span><span>Narrated</span></>)}
      </p>

      <h1
        class="h-display article-title mt-5 text-[2.75rem] sm:text-[3.25rem] md:text-[4.5rem]"
        transition:name={`title-${entry.id}`}
      >{d.title}</h1>

      <p class="reveal mt-7 font-serif text-[1.25rem] leading-[1.5] text-muted md:text-[1.375rem]" style="text-wrap: pretty; --d: 2">
        {d.summary}
      </p>

      {d.audioUrl && (
        <div class="reveal mt-10" style="--d: 3">
          <AudioPlayer src={d.audioUrl} title="Listen" client:visible />
        </div>
      )}
    </header>

    <!-- ───────── Series + takeaways ───────── -->
    {(series.length > 1 || d.highlights.length > 0) && (
      <div class="wrap-narrow mt-14 space-y-14 md:mt-16">
        {series.length > 1 && <SeriesNav current={entry.id} series={series} />}
        <Highlights items={d.highlights} />
      </div>
    )}

    <!-- ───────── Body (with xl TOC rail) ───────── -->
    <div class="article-grid mt-16 md:mt-20">
      {showToc && (
        <aside class="article-rail hidden xl:block">
          <Toc headings={toc} variant="rail" />
        </aside>
      )}

      <div class="article-main min-w-0">
        {showToc && (
          <div class="wrap-narrow mb-12 xl:hidden">
            <Toc headings={toc} variant="inline" />
          </div>
        )}
        <div class="wrap-narrow">
          <div class="prose-lab">
            <Content />
          </div>
          <p class="mt-16 flex items-center gap-3 text-faint" aria-hidden="true">
            <span class="h-px flex-1 bg-line/10"></span>
            <span class="num text-xs"><span class="text-accent">№</span> {entryNo(entry.id)} · end</span>
            <span class="h-px flex-1 bg-line/10"></span>
          </p>
        </div>

        {showVideo && (
          <div class="wrap-narrow mt-20">
            <LiteYouTube id={d.youtube_video_id!} title={d.youtube_title || d.title} />
          </div>
        )}
      </div>
    </div>
  </article>

  <div class="mb-24 mt-12 md:mb-32">
    <EntryFooter entry={entry} prev={prev} next={next} related={related} />
  </div>
</Layout>

<style>
  /* Centre the 700px reading column; on xl, the TOC sits in the left margin. */
  .article-grid { position: relative; }
  @media (min-width: 1280px) {
    .article-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(700px, 100%) minmax(0, 1fr);
      column-gap: 3.5rem;
      max-width: 1440px;
      margin-inline: auto;
      padding-inline: 2rem;
    }
    .article-main { grid-column: 2; }
    .article-rail { grid-column: 1; justify-self: end; width: 100%; max-width: 15rem; }
    .article-main :global(.wrap-narrow) { max-width: none; }
  }
</style>
