---
import Layout from '../../layouts/Layout.astro';
import EntryRow from '../../components/site/EntryRow.astro';
import { domainDotClass, domainOf, entryNo, formatDate, getEntries, siteStats, topicOf, type Entry } from '../../lib/content';
import { TRAILS } from '../../data/curation';

const entries = await getEntries();
const stats = siteStats(entries);
const domains = (['All', 'Engineering', 'Life', 'Work'] as const).map((name) => ({
  name,
  dot: name === 'All' ? 'bg-muted' : domainDotClass(name),
  count: name === 'All' ? stats.entries : entries.filter((entry) => domainOf(entry.data.category) === name).length,
}));

const byId = new Map(entries.map((entry) => [entry.id, entry]));
const months = new Map<string, Entry[]>();
for (const entry of entries) {
  const month = new Date(entry.data.date).toISOString().slice(0, 7);
  const group = months.get(month);
  if (group) group.push(entry);
  else months.set(month, [entry]);
}
const trails = TRAILS.map((t) => ({ ...t, entries: t.ids.flatMap((id) => byId.get(id) ?? []) })).filter((t) => t.entries.length > 1);
const countLabel = (count: number) => `${count} ${count === 1 ? 'entry' : 'entries'}`;
---

<Layout title="Journal">
  <journal-index class="block">
    <header class="wrap pb-7 pt-12 md:pb-9 md:pt-16">
      <p class="label"><i class="sq" aria-hidden="true"></i>Journal</p>
      <h1 class="h-display mt-5 text-[3.75rem] md:text-[6rem]">The <em>notebook</em><span class="text-accent">.</span></h1>
      <p class="dek mt-5 max-w-xl text-lg leading-relaxed md:text-xl">Every experiment, numbered. What I tried, what broke, and what I’d do differently.</p>
    </header>

    <div data-filter-edge hidden aria-hidden="true" class="h-px"></div>
    <div data-controls hidden class="sticky top-16 z-30 border-b border-transparent bg-bg/85 backdrop-blur-md">
      <div class="wrap">
        <form class="filter-bar grid items-center gap-x-5" role="search" aria-label="Filter the journal">
          <div class="filter-domains flex flex-wrap items-center gap-x-3.5 sm:gap-x-5" role="group" aria-label="Domain">
            {domains.map(({ name, dot, count }) => (
              <button type="button" data-domain-filter={name.toLowerCase()} aria-pressed={name === 'All' ? 'true' : 'false'} class="domain-toggle inline-flex min-h-10 items-center gap-1.5 border-b-2 border-transparent text-sm text-muted transition-colors hover:text-text aria-pressed:border-accent aria-pressed:text-text sm:min-h-12">
                <i class:list={['dot', dot]} aria-hidden="true"></i>{name} <span class="num text-xs text-muted">{count}</span>
              </button>
            ))}
          </div>

          <div class="filter-query flex min-w-0 items-center gap-2 border-b">
            <label for="journal-search" class="sr-only">Search titles, summaries, and topics</label>
            <svg class="ml-1 h-3.5 w-3.5 shrink-0 text-muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 3 3" stroke-linecap="round"/></svg>
            <input id="journal-search" name="q" type="search" autocomplete="off" placeholder="Filter entries…" class="min-h-10 min-w-0 flex-1 bg-transparent text-base placeholder:text-muted sm:text-sm" />
          </div>

          <div class="filter-media flex items-center gap-4" role="group" aria-label="Media">
            <button type="button" data-media-filter="audio" aria-pressed="false" class="media-toggle inline-flex min-h-10 items-center gap-1.5 whitespace-nowrap text-sm text-muted transition-colors hover:text-text aria-pressed:text-text">
              <span class="toggle-mark grid h-3 w-3 shrink-0 place-items-center rounded-[2px] border border-muted" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden h-2.5 w-2.5"><path d="m2.5 6 2.25 2.25 4.75-4.75"/></svg></span>
              Narrated
            </button>
            <button type="button" data-media-filter="video" aria-pressed="false" class="media-toggle inline-flex min-h-10 items-center gap-1.5 whitespace-nowrap text-sm text-muted transition-colors hover:text-text aria-pressed:text-text">
              <span class="toggle-mark grid h-3 w-3 shrink-0 place-items-center rounded-[2px] border border-muted" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden h-2.5 w-2.5"><path d="m2.5 6 2.25 2.25 4.75-4.75"/></svg></span>
              Has video
            </button>
          </div>

          <label class="filter-sort flex items-center justify-self-end">
            <span class="sr-only">Sort by date</span>
            <select name="sort" class="min-h-10 bg-transparent text-sm text-muted hover:text-text">
              <option value="newest">Newest</option>
              <option value="oldest">Oldest</option>
            </select>
          </label>
          <p class="filter-count num whitespace-nowrap text-right text-xs text-muted" data-result-count aria-live="polite" aria-atomic="true">{countLabel(stats.entries)}</p>
        </form>
        <p class="range-chip mt-2 hidden items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted [&:not([hidden])]:flex" data-range hidden>
          <span class="sq"></span><span>Window</span>
          <span class="text-text" data-range-label></span>
          <button type="button" class="ml-1 inline-flex min-h-8 items-center rounded-full border px-2.5 normal-case tracking-normal text-muted transition-colors hover:border-text/40 hover:text-text" data-range-clear aria-label="Clear date window">Clear ×</button>
        </p>
      </div>
    </div>

    <section class="wrap pt-3" aria-labelledby="index-heading">
      <h2 id="index-heading" class="sr-only">Entry index</h2>


      <div data-empty hidden class="border-y py-10 md:py-14">
        <h3 class="h-display text-3xl">No matching entries.</h3>
        <p class="dek mt-2 text-sm">Try a broader search or remove a filter.</p>
        <a href="/journal/" class="link mt-2 inline-flex min-h-10 items-center text-sm">Clear filters</a>
      </div>

      <div data-months>
        {[...months].map(([month, group]) => (
          <section data-month aria-labelledby={`month-${month}`} class="month-group grid items-start gap-x-6 lg:grid-cols-[9rem_minmax(0,1fr)] xl:grid-cols-[10rem_minmax(0,1fr)]">
            <div class="month-heading flex items-baseline justify-between gap-3 lg:block">
              <h3 id={`month-${month}`} class="flex items-baseline gap-2.5 lg:block">
                <span class="font-display text-2xl leading-none lg:block lg:text-[1.9rem]">{formatDate(`${month}-01`, { month: 'long' })}</span>
                <span class="num text-[11px] text-faint lg:mt-1.5 lg:block">{month.slice(0, 4)}</span>
              </h3>
              <p data-month-count class="num shrink-0 text-[11px] text-muted lg:mt-3">{countLabel(group.length)}</p>
            </div>
            <div data-month-rows>
              {group.map((entry) => (
                <EntryRow entry={entry} attrs={{
                  'data-domain': domainOf(entry.data.category).toLowerCase(),
                  'data-audio': entry.data.audioUrl ? '1' : '0',
                  'data-video': entry.data.youtube_video_id ? '1' : '0',
                  'data-search': [entry.data.title, entry.data.summary, topicOf(entry.data.category)].join('\n').toLowerCase(),
                  'data-date': entry.data.date,
                  'data-entry-id': entry.id,
                }} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="wrap pb-20 pt-14 md:pb-24 md:pt-20" aria-labelledby="trails-heading">
      <div class="border-t pt-6">
        <h2 id="trails-heading" class="label"><i class="sq" aria-hidden="true"></i>Trails</h2>
        <p class="dek mt-2 max-w-xl text-sm">A few threads that run across months. Topics stay searchable with the filter above.</p>
        <ul class="mt-6 grid gap-x-10 md:grid-cols-2">
          {trails.map((t) => (
            <li class="border-t py-5">
              <p class="h-title text-base">{t.name}</p>
              <p class="dek mt-1 text-sm">{t.note}</p>
              <ol class="num mt-3 flex flex-wrap gap-x-4 text-xs">
                {t.entries.map((e) => (
                  <li><a href={`/journal/${e.id}/`} class="inline-flex min-h-10 items-center text-muted transition-colors hover:text-accent" title={e.data.title}><span class="text-accent">№</span>&nbsp;{entryNo(e.id)}</a></li>
                ))}
              </ol>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </journal-index>
</Layout>

<style>
  journal-index :global([hidden]) { display: none !important; }
  [data-controls].is-stuck { border-bottom-color: rgb(var(--line) / var(--hair-a)); }

  .media-toggle[aria-pressed="true"] .toggle-mark { border-color: rgb(var(--accent)); color: rgb(var(--accent)); }
  .media-toggle[aria-pressed="true"] svg { display: block; }


  .month-heading {
    position: sticky;
    top: var(--month-sticky-top, 65px);
    z-index: 10;
    background: rgb(var(--bg));
    padding-block: 0.75rem;
    border-top-width: 1px;
    border-bottom-width: 1px;
  }
  @media (min-width: 1024px) {
    .month-group { border-top-width: 1px; }
    .month-heading { padding-block: 1.5rem; border: 0; }
  }

  [data-month-rows] > :global(a:not([hidden]):nth-child(1 of :not([hidden]))) { border-top-color: transparent; }
  [data-month-rows] :global(.row-title) { font-weight: 450; color: rgb(var(--text) / 0.92); }
  [data-month-rows] :global(.index-row:hover .row-title) { color: rgb(var(--accent)); }
  [data-month-rows] :global(.num.text-faint), [data-month-rows] :global(.num > .text-faint) { color: rgb(var(--muted)); }
  [data-month-rows] :global(.index-row:hover > .num:first-child) { color: rgb(var(--accent)); }

  .filter-bar {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "domains domains" "query count" "media sort";
    padding-block: 0.25rem;
  }
  .filter-domains { grid-area: domains; }
  .filter-query { grid-area: query; }
  .filter-media { grid-area: media; }
  .filter-sort { grid-area: sort; }
  .filter-count { grid-area: count; min-inline-size: 10ch; }
  @media (min-width: 640px) {
    .filter-bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "domains query count" "media sort sort";
    }
  }
  @media (min-width: 1024px) {
    .filter-bar {
      grid-template-columns: auto minmax(0, 1fr) auto auto auto;
      grid-template-areas: "domains query media sort count";
    }
  }
  @media (max-width: 767px) {
    [data-month-rows] > :global(a.index-row) {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      column-gap: 0.625rem;
      padding-inline: 0;
    }
  }
</style>

<script>
  import { matchesJournalFilters, readJournalFilters, writeJournalFilters } from '../../components/journal/JournalFilter';

  class JournalIndex extends HTMLElement {
    private cleanup?: AbortController;
    private observer?: IntersectionObserver;
    private resize?: ResizeObserver;

    connectedCallback() {
      const controls = this.querySelector<HTMLElement>('[data-controls]')!;
      const edge = this.querySelector<HTMLElement>('[data-filter-edge]')!;
      const form = controls.querySelector('form')!;
      const query = form.querySelector<HTMLInputElement>('[name="q"]')!;
      const sort = form.querySelector<HTMLSelectElement>('[name="sort"]')!;
      const domainButtons = [...form.querySelectorAll<HTMLButtonElement>('[data-domain-filter]')];
      const mediaButtons = [...form.querySelectorAll<HTMLButtonElement>('[data-media-filter]')];
      const count = this.querySelector<HTMLElement>('[data-result-count]')!;
      const empty = this.querySelector<HTMLElement>('[data-empty]')!;
      const range = this.querySelector<HTMLElement>('[data-range]')!;
      const rangeLabel = range.querySelector<HTMLElement>('[data-range-label]')!;
      const fmtDay = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      const monthList = this.querySelector<HTMLElement>('[data-months]')!;
      const months = [...monthList.querySelectorAll<HTMLElement>('[data-month]')].map((month) => {
        const list = month.querySelector<HTMLElement>('[data-month-rows]')!;
        const badge = month.querySelector<HTMLElement>('[data-month-count]')!;
        const rows = [...list.querySelectorAll<HTMLElement>('[data-date]')].map((row) => ({ row }));
        return { month, list, badge, rows };
      });
      let state = readJournalFilters(new URLSearchParams(location.search));
      // The initial DOM is newest-first; reverse it only when the sort changes.
      let currentSort = 'newest';

      const render = () => {
        if (state.sort !== currentSort) {
          months.reverse();
          monthList.append(...months.map(({ month }) => month));
          for (const group of months) group.list.append(...group.rows.reverse().map(({ row }) => row));
          currentSort = state.sort;
        }

        let total = 0;
        const needle = state.query.trim().toLowerCase();
        for (const { month, rows, badge } of months) {
          let visible = 0;
          for (const { row } of rows) {
            const match = matchesJournalFilters(row.dataset, state, needle);
            row.hidden = !match;
            if (match) visible++;
          }
          month.hidden = visible === 0;
          badge.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
          total += visible;
        }
        const message = `${total} ${total === 1 ? 'entry' : 'entries'}`;
        if (count.textContent !== message) count.textContent = message;
        empty.hidden = total !== 0;
      };

      const sync = () => {
        query.value = state.query;
        sort.value = state.sort;
        for (const button of domainButtons) button.setAttribute('aria-pressed', String(button.dataset.domainFilter === state.domain));
        for (const button of mediaButtons) button.setAttribute('aria-pressed', String(button.dataset.mediaFilter === 'audio' ? state.audio : state.video));
        range.hidden = !state.from && !state.to;
        rangeLabel.textContent = `${state.from ? fmtDay(state.from) : 'start'} – ${state.to ? fmtDay(state.to) : 'now'}`;
        render();
      };

      const update = () => {
        const url = new URL(location.href);
        writeJournalFilters(url.searchParams, state);
        if (url.href !== location.href) history.replaceState(history.state, '', url);

        // If filtering mid-index, keep the controls in place and bring the
        // first match (or empty state) back into view beneath them.
        const offset = edge.getBoundingClientRect().bottom - 64;
        const resultsStart = window.scrollY + offset;
        sync();
        if (offset < -1) window.scrollTo(0, resultsStart);
      };

      this.cleanup = new AbortController();
      const { signal } = this.cleanup;
      form.addEventListener('submit', (event) => event.preventDefault(), { signal });
      query.addEventListener('input', () => { state.query = query.value; update(); }, { signal });
      sort.addEventListener('change', () => { state.sort = sort.value === 'oldest' ? 'oldest' : 'newest'; update(); }, { signal });
      for (const button of domainButtons) {
        button.addEventListener('click', () => {
          const domain = button.dataset.domainFilter;
          if (domain === 'all' || domain === 'engineering' || domain === 'life' || domain === 'work') {
            state.domain = domain;
            update();
          }
        }, { signal });
      }
      for (const button of mediaButtons) {
        button.addEventListener('click', () => {
          if (button.dataset.mediaFilter === 'audio') state.audio = !state.audio;
          else state.video = !state.video;
          update();
        }, { signal });
      }
      range.querySelector('[data-range-clear]')!.addEventListener('click', () => { state.from = ''; state.to = ''; update(); }, { signal });
      const restore = () => {
        state = readJournalFilters(new URLSearchParams(location.search));
        sync();
      };
      window.addEventListener('popstate', restore, { signal });
      // Astro installs the new body before updating location.
      document.addEventListener('astro:after-swap', restore, { signal });

      sync();
      controls.hidden = false;
      edge.hidden = false;
      this.observer = new IntersectionObserver(([entry]) => {
        controls.classList.toggle('is-stuck', entry.boundingClientRect.bottom <= 65 && !entry.isIntersecting);
      }, { rootMargin: '-65px 0px 0px 0px' });
      this.observer.observe(edge);

      const setMonthOffset = () => this.style.setProperty('--month-sticky-top', `${64 + controls.offsetHeight}px`);
      setMonthOffset();
      this.resize = new ResizeObserver(setMonthOffset);
      this.resize.observe(controls);
    }

    disconnectedCallback() {
      this.cleanup?.abort();
      this.observer?.disconnect();
      this.resize?.disconnect();
    }
  }

  customElements.define('journal-index', JournalIndex);
</script>
