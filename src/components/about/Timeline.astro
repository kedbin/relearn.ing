---
import type { ExperienceItem } from '../../data/about';

interface Props {
  items: ExperienceItem[];
}
const { items } = Astro.props;
---

<ol class="border-b">
  {items.map((x, i) => (
    <li class:list={['grid gap-x-8 gap-y-3 pb-7 md:grid-cols-[9.5rem_1fr] md:pb-8', i > 0 ? 'border-t pt-7 md:pt-8' : 'pt-0']}>
      <p class="num pt-1 text-xs text-muted">
        {x.start} <span class="text-faint">–</span> <span class:list={[x.end === 'Present' && 'text-accent']}>{x.end}</span>
      </p>
      <div>
        <h3 class="h-title text-xl md:text-[1.375rem]">
          {x.role} <span class="text-muted">· {x.company}</span>
        </h3>
        {x.note && (
          <p class="mt-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-faint">
            {x.note}{x.aside && <span class="normal-case tracking-normal text-faint/80"> · {x.aside}</span>}
          </p>
        )}
        <ul class="mt-4 max-w-[64ch] space-y-2 text-[0.975rem] leading-relaxed text-text/85">
          {x.bullets.map((b) => (
            <li class="relative pl-5">
              <span class="absolute left-0 top-[0.72em] h-px w-2.5 bg-accent" aria-hidden="true"></span>{b}
            </li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>
