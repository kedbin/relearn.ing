---
/**
 * FIG. 01 for journal entry 069: Pi in Termux keeps the context and approvals. It hands a scoped
 * task to a named agent on another machine; that agent works in its own checkout and reports back
 * on the reply route it was given. Only the Windows laptop is verified; the Linux VPS is proposed.
 * One-shot SSH is a secondary diagnostic mode, not the main story.
 *
 * Layers: the SVG diagram, the phase strip and the facts list are the complete figure without JS.
 * With JS the native radio controls, phase strip and log work everywhere and the SVG packet moves.
 * With WebGL a lazily loaded Three.js scene replaces the SVG at the same stage size. Palette roles only.
 */
import { LOCAL_STEPS, MODES, TARGETS, outcome, phases } from './routes';
import { CODE } from './code';

const y = { laptop: 100, vps: 300 } as const;
// Two lanes per target: outbound (task) and inbound (report). Outbound is the outer lane.
const lanes = {
  laptop: { out: 'M146 172 C 250 108, 350 82, 456 88', back: 'M456 114 C 350 122, 250 168, 146 192' },
  vps: { out: 'M146 228 C 250 292, 350 318, 456 312', back: 'M456 286 C 350 278, 250 232, 146 208' },
} as const;
const flow = phases('agent');
const first = outcome(TARGETS[0], 'agent');
const steps = LOCAL_STEPS.agent;
---

<section class="cc" id="control-center" aria-labelledby="control-center-h">
  <p class="kicker">FIG. 01 <i></i> ASSIGN, WORK LOCALLY, REPORT BACK</p>
  <h2 id="control-center-h">Hand off the task, <em>not the shell</em></h2>
  <p class="intro">Pi in Termux keeps the conversation and the approvals. It gives a named agent on another machine a scoped task and a reply route. That agent works in its own checkout with its own tools, then sends a short report back on the same route. Press Play and watch the code light up as the task goes out, the work happens, and the report comes back.</p>

  <control-center data-selected="laptop" data-mode="agent" data-kind="idle">
    <div class="plate">
      <div class="stage" data-stage>
        <div class="poster" data-poster>
          <svg viewBox="0 0 720 400" preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="cc-svg-t cc-svg-d">
            <title id="cc-svg-t">Pi in Termux assigns a task to an agent on another machine and receives its report</title>
            <desc id="cc-svg-d">Two lanes run between the phone and each target. The outbound lane carries a scoped task and a reply route to the target. The target agent works locally in its own checkout: read the brief, edit, run checks, write a report file. The inbound lane carries the report back: verdict, checks, blockers and report path. Lanes to the Windows laptop are solid and marked verified. Lanes to the Linux VPS are dashed and marked proposed; they go directly from the phone, not through the laptop.</desc>
            <defs>
              <pattern id="cc-dots" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r=".9" fill="rgb(var(--surface-2))" /></pattern>
              <marker id="cc-ah-out" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="rgb(var(--accent))" /></marker>
              <marker id="cc-ah-back" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="rgb(var(--eng))" /></marker>
              <marker id="cc-ah-dim" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="rgb(var(--metal))" /></marker>
            </defs>
            <rect width="720" height="400" fill="url(#cc-dots)" />
            <g fill="none" stroke-width="2" stroke-linecap="round">
              {TARGETS.map((t) => (
                <g data-lanes={t.id} class:list={['lanes', t.status]}>
                  <path data-lane="out" class="lane out" d={lanes[t.id].out} />
                  <path data-lane="back" class="lane back" d={lanes[t.id].back} />
                </g>
              ))}
            </g>
            <g class="lane-notes" aria-hidden="true">
              <text x="300" y="86" text-anchor="middle" class="svg-note out">task + reply route →</text>
              <text x="300" y="176" text-anchor="middle" class="svg-note back">← report</text>
            </g>
            <g>
              <rect x="40" y="120" width="88" height="160" rx="14" fill="rgb(var(--chassis))" />
              <rect x="48" y="134" width="72" height="132" rx="4" fill="rgb(var(--bg))" />
              <path d="M56 150h34M56 162h46M56 174h24" stroke="rgb(var(--accent))" stroke-width="3" stroke-linecap="round" />
              <path class="inbox" data-inbox d="M56 196h52" stroke="rgb(var(--eng))" stroke-width="3" stroke-linecap="round" />
              <text x="84" y="304" text-anchor="middle" class="svg-label">Termux + Pi</text>
              <text x="84" y="320" text-anchor="middle" class="svg-sub">context · approvals</text>
            </g>
            {TARGETS.map((t) => {
              const cy = y[t.id];
              return (
                <g data-node={t.id} class="node">
                  {t.kind === 'laptop'
                    ? <><rect x="468" y={cy - 30} width="66" height="42" rx="4" fill="rgb(var(--chassis))" /><rect x="474" y={cy - 25} width="54" height="32" fill="rgb(var(--bg))" /><rect x="460" y={cy + 12} width="82" height="7" rx="3" fill="rgb(var(--chassis))" /></>
                    : <><rect x="466" y={cy - 22} width="70" height="20" rx="3" fill="rgb(var(--chassis))" /><rect x="466" y={cy + 2} width="70" height="20" rx="3" fill="rgb(var(--metal))" /><circle cx="526" cy={cy - 12} r="3" fill="rgb(var(--accent))" /><circle cx="526" cy={cy + 12} r="3" fill="rgb(var(--accent))" /></>}
                  <g class="chips" aria-hidden="true">
                    {steps.map((_, i) => <rect data-chip={i} class="chip" x={471 + i * 16} y={cy - 50} width="12" height="10" rx="2" />)}
                  </g>
                  <text x="556" y={cy - 10} class="svg-label">{t.name}</text>
                  <text x="556" y={cy + 6} class="svg-sub">{t.role}</text>
                  <text x="556" y={cy + 22} class:list={['svg-sub', 'status', t.status]}>{t.status}</text>
                </g>
              );
            })}
            <g class="legend" aria-hidden="true" transform="translate(40 368)">
              <path d="M0 0h26" stroke="rgb(var(--accent))" stroke-width="2" marker-end="url(#cc-ah-out)" />
              <text x="34" y="4" class="svg-sub">outbound: task</text>
              <path d="M150 0h26" stroke="rgb(var(--eng))" stroke-width="2" marker-end="url(#cc-ah-back)" />
              <text x="184" y="4" class="svg-sub">inbound: report</text>
              <path d="M310 0h26" stroke="rgb(var(--metal))" stroke-width="2" stroke-dasharray="5 4" />
              <text x="344" y="4" class="svg-sub">dashed: proposed</text>
              <rect x="474" y="-5" width="12" height="10" rx="2" fill="rgb(var(--eng))" />
              <text x="494" y="4" class="svg-sub">local step done</text>
            </g>
            <circle class="svg-packet" data-svg-packet r="7" cx="146" cy="172" />
          </svg>
        </div>
        <span class="tag phone" data-tag="phone" hidden aria-hidden="true"><b>PI</b> Termux<small>context · approvals</small></span>
        {TARGETS.map((t) => (
          <span class:list={['tag', t.status]} data-tag={t.id} hidden aria-hidden="true">{t.name}<small>{t.status}</small></span>
        ))}
        <span class="tag work" data-tag="work" hidden aria-hidden="true"></span>
        <span class="tag packet" data-tag="packet" hidden aria-hidden="true"></span>
      </div>

      <ol class="overview" aria-label="Hand-off at a glance">
        {flow.map((p, i) => <li><small>{i + 1} · {['Phone', 'Target', 'Phone'][i]}</small><b data-overview>{p.title}</b></li>)}
      </ol>

      <div class="code" data-code>
        <div class="run" data-run hidden>
          <button type="button" class="send" data-send>Play the hand-off</button>
          <div class="tabs" role="radiogroup" aria-label="Show code for">
            {CODE.map((c, i) => (
              <label data-tab={c.id} hidden={c.id === 'ssh'}>
                <input class="sr-only" type="radio" name="cc-code" value={c.id} checked={i === 0} />
                <span>{c.label}</span>
              </label>
            ))}
          </div>
          <span class="status" data-status aria-live="polite"></span>
          <p class="motion" data-motion hidden>Reduced motion: Play jumps to the end state without animation.</p>
        </div>
        <p class="nojs" data-nojs>Static view: the Play button and the 3D scene need JavaScript. The diagram, the code and the steps below tell the same story.</p>
        {CODE.map((c) => (
          <figure class="panel" data-panel={c.id}>
            <figcaption><b>{c.label}</b> · {c.where}</figcaption>
            <pre tabindex="0"><code>{c.lines.map((l, i) => <span class="ln" data-line={i} data-at={l.at} data-step={l.step}>{l.text || ' '}</span>)}</code></pre>
          </figure>
        ))}
        <p class="code-note">Illustrative. The browser runs none of this. <code>build-vps</code> is a placeholder for the proposed Linux VPS. Herdr Core carries the task and the reply over the SSH connection it already holds, so nothing polls.</p>
      </div>

      <aside class="addr" data-addr aria-labelledby="cc-addr-h">
        <h3 id="cc-addr-h">Why the reply address matters</h3>
        <p>A bare <code>t1</code> means “t1 on whichever core reads it”. The <a href="https://github.com/herdrdev/herdr-core/blob/v0.1.21/docs/machines.md#what-runs-where">Machines guide</a> says to use the full <code>machine/tN</code> address from another machine, and the <a href="https://github.com/herdrdev/herdr-core/blob/v0.1.21/crates/herdr-core/tests/remote.rs#L360-L368">cross-machine test</a> does exactly that: the remote child reads its qualified <code>parent</code> and sends to it.</p>
        <svg viewBox="0 0 360 172" role="img" aria-labelledby="cc-addr-t cc-addr-d">
          <title id="cc-addr-t">Two cores, two different t1 terminals</title>
          <desc id="cc-addr-d">On build-vps, the worker t4 sending to bare t1 reaches build-vps's own t1, the wrong terminal. Instead it reads its parent, phone/t1, from its own record on build-vps and sends there. The message goes over the connection the phone already holds and lands in Pi.</desc>
          <defs><marker id="cc-addr-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="rgb(var(--eng))" /></marker></defs>
          <text x="8" y="18" class="a-core">phone core</text>
          <rect x="8" y="26" width="132" height="58" class="a-box" />
          <rect x="18" y="40" width="112" height="30" class="a-row pi" /><text x="26" y="60" class="a-t">t1 · Pi</text>
          <text x="196" y="18" class="a-core">build-vps core</text>
          <rect x="196" y="26" width="156" height="104" class="a-box" />
          <rect x="206" y="40" width="108" height="30" class="a-row dim" /><text x="214" y="60" class="a-t dim">t1 · other</text>
          <rect x="206" y="88" width="108" height="30" class="a-row me" /><text x="214" y="108" class="a-t">t4 · worker</text>
          <path d="M316 103 C 344 103, 344 55, 318 55" class="a-bad" />
          <text x="338" y="84" text-anchor="middle" class="a-x">✕</text>
          <path class="a-good" d="M206 103 C 168 103, 172 55, 134 55" marker-end="url(#cc-addr-ah)" />
          <text x="168" y="40" text-anchor="middle" class="a-lbl">phone/t1</text>
          <text x="8" y="150" class="a-cap">.parent read on build-vps: no new dial or agent</text>
          <text x="8" y="166" class="a-cap">reply rides the SSH link the phone already holds</text>
        </svg>
        <ol class="hops">
          <li class="bad"><code>hc send t1</code> from the worker → build-vps’s own t1. Wrong terminal.</li>
          <li><b>Worker side, on build-vps:</b> <code>hc get "$HC_TERMINAL_ID" --json</code> → <code>.parent</code> is <code>phone/t1</code>. A lookup in its own record, not a new connection or a new agent.</li>
          <li class="good"><code>hc send phone/t1 "[date-fix] …"</code> → travels back over the existing connection → Pi sees <code>&lt;hc from="build-vps/t4"&gt;[date-fix] …</code>. No polling; <code>hc wait</code> is optional.</li>
          <li>Follow-ups go to the same worker: <code>hc send build-vps/t4 "…"</code>. One interactive agent, reused, not a fresh spawn per reply.</li>
        </ol>
        <p class="fine">Addresses are fictional. The direct VPS route is still proposed.</p>
      </aside>

      <div class="desk" data-controls hidden>
        <fieldset class="pick">
          <legend>Target</legend>
          <div class="opts">
            {TARGETS.map((t, i) => (
              <label>
                <input class="sr-only" type="radio" name="cc-target" value={t.id} checked={i === 0} />
                <span><b>{t.name}</b><small class={t.status}>{t.status === 'verified' ? 'Verified' : 'Proposed'} · {t.role}</small></span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="pick">
          <legend>Hand-off</legend>
          <div class="opts">
            {MODES.map((m, i) => (
              <label>
                <input class="sr-only" type="radio" name="cc-mode" value={m.id} checked={i === 0} />
                <span><b>{m.label}</b><small>{m.hint}</small></span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="log" role="group" aria-label="Task and result">
          <p><span class="who out">→</span> <span data-brief>{first.brief}</span></p>
          <p><span class="who back">←</span> <span data-result aria-live="polite">Press play to watch one hand-off.</span></p>
          <p class="evidence" data-evidence>{TARGETS[0].evidence}</p>
        </div>
      </div>

      <ol class="flow" data-flow aria-label="How a task moves">
        {flow.map((p, i) => (
          <li class:list={['phase', p.kind]} data-phase={i}>
            <span class="num" aria-hidden="true">{p.kind === 'out' ? '→' : p.kind === 'back' ? '←' : '⟳'}</span>
            <div>
              <b data-phase-title>{p.title}</b>
              <span class="payload" data-phase-payload>{p.payload}</span>
              <small data-phase-via>{p.via}</small>
              {p.kind === 'local' && (
                <ul class="steps" data-steps>
                  {steps.map((s) => <li>{s}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <details class="facts" data-facts open>
      <summary>The figure in words</summary>
      <ul>
        {TARGETS.map((t) => (
          <li>
            <span class:list={['badge', t.status]}>{t.status}</span>
            <div><b>{t.name}</b> · {t.role}<p>{t.evidence}</p></div>
          </li>
        ))}
        <li>
          <span class="badge">route</span>
          <div><b>Assign and report on one route</b><p>Herdr Core reaches the other machine over host-key-verified Tailscale SSH. The task goes out with a reply route; the agent reads its qualified parent (for example <code>phone/t1</code>) from its own record and answers with <code>hc send</code> to that address. There is no <code>hc receive</code>: a report arrives as a new message in the parent’s terminal. If that route is down, the report file the agent writes is still there to read.</p></div>
        </li>
        <li>
          <span class="badge">aside</span>
          <div><b>Not on this route</b><p>A one-shot SSH command is a quick diagnostic, not the way work gets handed off. The Windows preview server reaches the phone through a separate HTTP tunnel, not through Herdr Core.</p></div>
        </li>
      </ul>
    </details>

    <p class="fine">Illustration with role names only; no real hosts, users, terminals or paths. Playback timing is for demonstration. A simulated report is not evidence that the route works.</p>
  </control-center>
</section>

<script>
  import { LOCAL_STEPS, TARGETS, exchangeMs, finalFrame, frameAt, isMode, outcome, phases, targetById, type Frame, type Mode, type TargetId } from './routes';
  import type { CenterScene } from './scene';
  import { codeById, type CodePanel } from './code';

  function webglAvailable() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch { return false; }
  }

  const ANNOUNCE = { out: 'Task sent to the target.', local: 'Target agent working locally.', back: 'Report coming back.' } as const;

  class ControlCenter extends HTMLElement {
    private abort?: AbortController;
    private scene?: CenterScene;
    private raf = 0;

    connectedCallback() {
      this.abort?.abort();
      const abort = (this.abort = new AbortController());
      const { signal } = abort;
      const $ = <T extends Element>(s: string) => this.querySelector<T>(s);
      const $$ = <T extends Element>(s: string) => [...this.querySelectorAll<T>(s)];
      const stage = $<HTMLElement>('[data-stage]');
      const poster = $<HTMLElement>('[data-poster]');
      const controls = $<HTMLElement>('[data-controls]');
      const facts = $<HTMLDetailsElement>('[data-facts]');
      const send = $<HTMLButtonElement>('[data-send]');
      const briefEl = $<HTMLElement>('[data-brief]');
      const resultEl = $<HTMLElement>('[data-result]');
      const statusEl = $<HTMLElement>('[data-status]');
      const evidenceEl = $<HTMLElement>('[data-evidence]');
      const motionEl = $<HTMLElement>('[data-motion]');
      const stepsEl = $<HTMLElement>('[data-steps]');
      const svgPacket = $<SVGCircleElement>('[data-svg-packet]');
      const overview = $$<HTMLElement>('[data-overview]');
      const phaseEls = $$<HTMLElement>('[data-phase]');
      const runBar = $<HTMLElement>('[data-run]');
      const noJs = $<HTMLElement>('[data-nojs]');
      const panels = $$<HTMLElement>('[data-panel]');
      const tag = (k: string) => $<HTMLElement>('[data-tag="' + k + '"]') ?? undefined;
      if (!stage || !poster || !controls || !facts || !send || !briefEl || !resultEl || !statusEl || !evidenceEl || !stepsEl || !svgPacket || !runBar) return;

      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let selected: TargetId = 'laptop';
      let mode: Mode = 'agent';
      let run: { start: number; ms: number } | null = null;
      let t = -1; // playback time; -1 = idle
      let done = false; // resting after a completed run
      let lastPhase = -1;
      let deadline = 0;
      let code: CodePanel['id'] = 'pi';

      // The SVG figure is interactive on its own: show the controls now, before (and without) Three.
      controls.hidden = false;
      runBar.hidden = false;
      if (noJs) noJs.hidden = true;
      facts.open = false;
      this.dataset.ui = 'svg';

      const showCode = () => {
        if (mode === 'ssh') code = 'ssh';
        else if (code === 'ssh') code = 'pi';
        panels.forEach((el) => (el.hidden = el.dataset.panel !== code));
        $$<HTMLElement>('[data-tab]').forEach((el) => (el.hidden = (el.dataset.tab === 'ssh') !== (mode === 'ssh')));
        $$<HTMLInputElement>('input[name="cc-code"]').forEach((r) => (r.checked = r.value === code));
      };
      /** Highlight the code lines for the current phase; worker lines follow the local step. */
      const paintCode = (f: Frame | null) => {
        const panel = panels.find((el) => el.dataset.panel === code);
        if (!panel) return;
        const usesSteps = code !== 'pi';
        panel.querySelectorAll<HTMLElement>('[data-line]').forEach((ln) => {
          const at = ln.dataset.at, step = ln.dataset.step === undefined ? -1 : Number(ln.dataset.step);
          let on = !!f && at === f.kind;
          if (on && f!.kind === 'local' && usesSteps && step >= 0) on = step === f!.step;
          ln.classList.toggle('is-on', on);
          ln.classList.toggle('is-done', done && !!at);
        });
        const lit = panel.querySelector<HTMLElement>('.ln.is-on');
        const pre = panel.querySelector('pre');
        if (lit && pre) { // keep the lit line in view inside the panel, without scrolling the page
          const top = lit.offsetTop - pre.clientHeight / 2;
          if (lit.offsetTop < pre.scrollTop || lit.offsetTop > pre.scrollTop + pre.clientHeight - 24) pre.scrollTop = Math.max(0, top);
        }
      };

      const label = () => mode === 'agent' ? 'Play the hand-off' : 'Play the SSH check';
      const describe = () => {
        const target = targetById(selected);
        briefEl.textContent = outcome(target, mode).brief;
        evidenceEl.textContent = target.evidence;
        phases(mode).forEach((p, i) => {
          const caption = overview[i]; if (caption) caption.textContent = p.title;
          const li = phaseEls[i]; if (!li) return;
          li.querySelector('[data-phase-title]')!.textContent = p.title;
          li.querySelector('[data-phase-payload]')!.textContent = p.payload;
          li.querySelector('[data-phase-via]')!.textContent = target.status === 'proposed' && p.kind !== 'local' ? p.via + ' (proposed)' : p.via;
        });
        stepsEl.replaceChildren(...LOCAL_STEPS[mode].map((s) => Object.assign(document.createElement('li'), { textContent: s })));
        this.dataset.selected = selected;
        this.dataset.mode = mode;
        showCode();
      };

      const paintFlow = (f: Frame | null) => {
        this.dataset.kind = f ? f.kind : done ? 'done' : 'idle';
        phaseEls.forEach((li, i) => {
          const isOn = !!f && f.phase === i;
          li.classList.toggle('is-on', isOn);
          li.classList.toggle('is-done', done || (!!f && f.phase > i));
          if (isOn) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
        });
        [...stepsEl.children].forEach((li, i) => {
          li.classList.toggle('is-on', !!f && f.kind === 'local' && f.step === i);
          li.classList.toggle('is-done', done || (!!f && f.step > i));
        });
        const count = LOCAL_STEPS[mode].length;
        $$<SVGRectElement>('[data-node="' + selected + '"] [data-chip]').forEach((c, i) => {
          c.classList.toggle('is-on', !!f && f.kind === 'local' && f.step === i);
          c.classList.toggle('is-done', done || (!!f && f.step > i));
          c.classList.toggle('is-unused', i >= count);
        });
      };

      // Losing an optional renderer must never cancel the playback clock.
      const fallback = () => {
        const scene = this.scene;
        this.scene = undefined;
        try { scene?.dispose(); } catch (error) { console.warn('Control center: scene cleanup failed.', error); }
        stage.querySelector('.center-canvas')?.remove();
        this.classList.remove('is-live');
        this.dataset.ui = 'svg';
        poster.hidden = false;
        stage.querySelectorAll<HTMLElement>('.tag').forEach((el) => (el.hidden = true));
      };

      const draw = () => {
        const f = t >= 0 ? frameAt(t, mode) : done ? finalFrame(mode) : null;
        const playing = t >= 0 ? f : null;
        paintFlow(playing);
        paintCode(playing);
        if (playing && playing.phase !== lastPhase) { lastPhase = playing.phase; statusEl.textContent = ANNOUNCE[playing.kind]; }
        if (this.scene) {
          const p = phases(mode);
          const pk = tag('packet'), wk = tag('work');
          if (pk && playing) pk.textContent = p[playing.phase].kind === 'out' ? '→ ' + p[0].title.toLowerCase() : mode === 'agent' ? '← [date-fix] to phone/t1' : '← ' + p[2].title.toLowerCase();
          if (wk && playing && playing.kind === 'local') wk.textContent = LOCAL_STEPS[mode][Math.max(0, playing.step)];
          try {
            this.scene.render({ selected, mode, frame: playing, done });
            return;
          } catch (error) {
            console.warn('Control center: rendering failed, continuing with the diagram.', error);
            fallback();
          }
        }
        // SVG fallback: the packet rides the outbound lane, then the inbound lane.
        svgPacket.style.visibility = playing?.packet ? 'visible' : 'hidden';
        if (playing?.packet) {
          const lane = this.querySelector<SVGPathElement>('[data-lanes="' + selected + '"] [data-lane="' + (playing.kind === 'out' ? 'out' : 'back') + '"]');
          if (lane && typeof lane.getPointAtLength === 'function') {
            const len = lane.getTotalLength();
            // The inbound path is drawn target → phone, so u (0 = phone) maps to the far end.
            const pt = lane.getPointAtLength((playing.kind === 'out' ? playing.u : 1 - playing.u) * len);
            svgPacket.setAttribute('cx', pt.x.toFixed(1));
            svgPacket.setAttribute('cy', pt.y.toFixed(1));
          }
        }
      };

      const finish = () => {
        clearTimeout(deadline);
        cancelAnimationFrame(this.raf); this.raf = 0;
        run = null; t = -1; done = true; lastPhase = -1;
        statusEl.textContent = 'Report received (simulated).';
        resultEl.textContent = outcome(targetById(selected), mode).result;
        send.removeAttribute('aria-disabled');
        send.textContent = 'Replay';
        draw();
      };

      const frame = (now: number) => {
        this.raf = 0;
        if (!run) return draw();
        if (document.hidden) { finish(); return; }
        t = Math.min(1, (now - run.start) / run.ms);
        draw();
        if (t >= 1) finish();
        else this.raf = requestAnimationFrame(frame);
      };
      const request = () => { if (!this.raf) this.raf = requestAnimationFrame(frame); };

      const reset = () => {
        clearTimeout(deadline);
        cancelAnimationFrame(this.raf); this.raf = 0;
        run = null; t = -1; done = false; lastPhase = -1;
        send.removeAttribute('aria-disabled');
        send.textContent = label();
        statusEl.textContent = '';
        resultEl.textContent = 'Press play to watch one hand-off.';
        describe();
        request();
      };

      $$<HTMLInputElement>('input[name="cc-target"]').forEach((r) => r.addEventListener('change', () => {
        if (r.checked) { selected = targetById(r.value).id; reset(); }
      }, { signal }));
      $$<HTMLInputElement>('input[name="cc-mode"]').forEach((r) => r.addEventListener('change', () => {
        if (r.checked && isMode(r.value)) { mode = r.value; reset(); }
      }, { signal }));

      $$<HTMLInputElement>('input[name="cc-code"]').forEach((r) => r.addEventListener('change', () => {
        if (r.checked) { code = r.value as CodePanel['id']; showCode(); paintCode(t >= 0 ? frameAt(t, mode) : null); }
      }, { signal }));

      send.addEventListener('click', () => {
        if (run) return; // already playing; aria-disabled keeps focus on the button
        describe();
        done = false;
        // Bring the figure into view if Play was tapped with the stage scrolled away.
        const r = stage.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) stage.scrollIntoView({ block: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
        if (reduced.matches) { finish(); return; }
        resultEl.textContent = targetById(selected).status === 'proposed' ? 'Playing (illustration only)…' : 'Playing…';
        send.setAttribute('aria-disabled', 'true');
        run = { start: performance.now(), ms: exchangeMs(mode) };
        // Completion is independent of rAF delivery (and any drawing error).
        deadline = window.setTimeout(finish, run.ms);
        request();
      }, { signal });

      const syncMotion = () => { if (motionEl) motionEl.hidden = !reduced.matches; if (reduced.matches && run) finish(); };
      syncMotion();
      reduced.addEventListener('change', syncMotion, { signal });
      document.addEventListener('visibilitychange', () => { if (document.hidden && run) finish(); }, { signal });

      let started = false;
      const start = async () => {
        if (started || !webglAvailable() || this.hasAttribute('data-no-webgl')) return;
        started = true;
        try {
          const { createCenter } = await import('./scene');
          if (signal.aborted) return;
          this.classList.add('is-live');
          this.dataset.ui = '3d';
          poster.hidden = true;
          this.scene = createCenter(stage, {
            phone: tag('phone'), packet: tag('packet'), work: tag('work'),
            targets: Object.fromEntries(TARGETS.map((x) => [x.id, tag(x.id)])),
          });
        } catch (error) {
          console.warn('Control center: WebGL unavailable, keeping the diagram.', error);
          if (!signal.aborted) { fallback(); request(); }
          return;
        }
        stage.querySelector('canvas')?.addEventListener('webglcontextlost', (e) => { e.preventDefault(); fallback(); request(); }, { signal, once: true });
        request();
      };

      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !signal.aborted) { start(); request(); }
      }, { rootMargin: '400px 0px' });
      io.observe(stage);
      const ro = new ResizeObserver(() => { if (this.scene) { this.scene.resize(); request(); } });
      ro.observe(stage);
      const root = document.documentElement;
      let dark = root.classList.contains('dark');
      const theme = new MutationObserver(() => {
        if (dark === root.classList.contains('dark')) return;
        dark = !dark;
        this.scene?.refreshTheme();
        request();
      });
      theme.observe(root, { attributes: true, attributeFilter: ['class'] });
      signal.addEventListener('abort', () => {
        clearTimeout(deadline); io.disconnect(); ro.disconnect(); theme.disconnect(); fallback();
      });
      selected = targetById($<HTMLInputElement>('input[name="cc-target"]:checked')?.value ?? '').id;
      const checkedMode = $<HTMLInputElement>('input[name="cc-mode"]:checked')?.value;
      if (checkedMode && isMode(checkedMode)) mode = checkedMode;
      reset();
    }

    disconnectedCallback() {
      this.abort?.abort();
      cancelAnimationFrame(this.raf);
      this.raf = 0;

    }
  }

  if (!customElements.get('control-center')) customElements.define('control-center', ControlCenter);
</script>

