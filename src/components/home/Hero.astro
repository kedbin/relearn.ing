---
import type { Entry } from '../../lib/content';
import { entryNo, formatDate } from '../../lib/content';

interface Props { latest: Entry }
const { latest } = Astro.props;
---

<section class="wrap" aria-labelledby="intro-title">
  <div class="opening">
    <div>
      <h1 id="intro-title" class="headline font-display">Automation<br />in practice.</h1>
      <p class="mt-4 max-w-[37ch] text-base leading-relaxed text-muted md:mt-6 md:text-lg">Case studies in coding agents, deployment pipelines and the choices behind them.</p>
    </div>

    <a href={`/journal/${latest.id}/`} class="feature group flex flex-col justify-between bg-surface">
      <div class="flex items-center justify-between border-b pb-3">
        <span class="label"><i class="sq" aria-hidden="true"></i>Latest entry</span>
        <span class="num text-xs text-muted">№ {entryNo(latest.id)}</span>
      </div>
      <h2 class="feature-title font-display group-hover:text-accent" transition:name={`title-${latest.id}`}>{latest.data.title}</h2>
      <div class="flex items-baseline justify-between gap-2">
        <span class="num text-xs text-muted">{formatDate(latest.data.date)}</span>
        <span class="text-sm text-accent">Read entry <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </div>
</section>

<style>
  .opening { display: grid; gap: 1.5rem; padding-top: 2rem; }
  .headline { font-size: clamp(4rem, 8.5vw, 7.4rem); line-height: .92; letter-spacing: -.04em; }
  .feature { padding: 1.15rem 1.25rem; border-top: 2px solid rgb(var(--text)); }
  .feature-title { font-size: clamp(2rem, 3.3vw, 3rem); line-height: 1.02; letter-spacing: -.018em; margin: 1rem 0 1.25rem; text-wrap: balance; }
  @media (min-width: 768px) {
    .opening { grid-template-columns: 1.17fr 1fr; align-items: stretch; gap: clamp(2rem, 6vw, 6rem); padding-top: 3.75rem; }
    .feature { padding: 1.5rem 1.75rem; }
  }
</style>
