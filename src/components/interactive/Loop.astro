---
/**
 * The relearning loop: Friction → Hypothesis → Experiment → Log → (Friction).
 *
 * Server-rendered as an ordered list of the four stages, each with a real journal
 * example and the notebook rule it runs on. The hairline ring is decorative
 * (aria-hidden). With JS, the list becomes a tab set: one stage panel at a time,
 * an ink dot that travels the ring, and auto-advance while it's in view.
 */
import { getEntries, entryNo } from '../../lib/content';
import { principles } from '../../data/about';
import { loopStages } from './loop-data';
import { pointOnCircle, stageAngle, LOOP_START } from './loop-geometry';

const VB = 400;
const C = VB / 2;
const R = 124;
const N = loopStages.length;

const visible = new Map((await getEntries()).map((e) => [e.id, e]));

const stages = loopStages.map((s, i) => {
  const angle = stageAngle(i, N, LOOP_START);
  const node = pointOnCircle(C, C, R, angle);
  const anchor = pointOnCircle(C, C, R + 10, angle);
  const entry = visible.get(s.example.id);
  return {
    ...s,
    i,
    no: String(i + 1).padStart(2, '0'),
    node,
    // Label sits outward from the node, towards its corner of the drawing.
    left: (anchor.x / VB) * 100,
    top: (anchor.y / VB) * 100,
    side: `${node.y < C ? 't' : 'b'}${node.x < C ? 'l' : 'r'}`,
    entry: entry ? { href: `/journal/${entry.id}/`, no: entryNo(entry.id), title: entry.data.title } : null,
    principle: principles[s.rule],
  };
});

// A dial: ticks every 5°, longer every 15°. Ticks clear out around the stage
// nodes so each node reads as a station on the line.
const stageAngles = stages.map((s) => stageAngle(s.i, N, LOOP_START));
const nearNode = (a: number) => stageAngles.some((s) => Math.abs((((a - s) % 360) + 540) % 360 - 180) < 8);
const ticks = Array.from({ length: 72 }, (_, k) => k * 5)
  .filter((a) => !nearNode(a))
  .map((a) => {
    const major = a % 15 === 0;
    const p = pointOnCircle(C, C, R + 6, a);
    const q = pointOnCircle(C, C, R + (major ? 13 : 9), a);
    return { p, q, major };
  });

// Flow chevrons halfway between stages, pointing clockwise along the tangent.
const chevrons = stages.map((s) => {
  const a = stageAngle(s.i, N, LOOP_START) + 180 / N;
  const p = pointOnCircle(C, C, R, a);
  return { p, rot: a + 90 };
});

const TRAIL_SEGMENTS = 8;
const first = stages[0];
---

<div class="loop" data-loop data-n={N} data-r={R} data-c={C} data-start={LOOP_START}>
  <div class="loop-grid">
    <div class="loop-figure">
      <div class="loop-dial">
        <svg viewBox={`0 0 ${VB} ${VB}`} class="loop-svg" aria-hidden="true" focusable="false">
          <!-- construction lines -->
          <g class="l-faint">
            <line x1={C - R - 40} y1={C} x2={C + R + 40} y2={C} stroke-dasharray="2 4" />
            <line x1={C} y1={C - R - 40} x2={C} y2={C + R + 40} stroke-dasharray="2 4" />
            <circle cx={C} cy={C} r={R - 34} fill="none" stroke-dasharray="1 3" />
          </g>
          <!-- dial -->
          <g class="l-tick">
            {ticks.map((t) => (
              <line x1={t.p.x} y1={t.p.y} x2={t.q.x} y2={t.q.y} class={t.major ? 'major' : ''} />
            ))}
          </g>
          <circle cx={C} cy={C} r={R} class="l-ring" fill="none" />
          <!-- centre registration mark -->
          <g class="l-faint">
            <circle cx={C} cy={C} r="3" fill="none" />
          </g>
          {chevrons.map((c) => (
            <path d="M -3.5 -4 L 1.5 0 L -3.5 4" class="l-chev" transform={`translate(${c.p.x} ${c.p.y}) rotate(${c.rot - 90})`} fill="none" />
          ))}
          <!-- ink trail: stacked translucent arcs, densest at the dot -->
          <g class="l-trail" data-trail>
            {Array.from({ length: TRAIL_SEGMENTS }, () => (
              <circle cx={C} cy={C} r={R} pathLength="360" fill="none" stroke-dasharray="0 360" />
            ))}
          </g>
          <!-- stage nodes -->
          {stages.map((s) => (
            <g class:list={['l-node', s.i === 0 && 'is-active']} data-node={s.i} transform={`translate(${s.node.x} ${s.node.y})`}>
              <circle r="9" class="l-node-reg" fill="none" />
              <circle r="3.5" class="l-node-dot" />
            </g>
          ))}
          <!-- the ink dot -->
          <g data-dot transform={`translate(${first.node.x} ${first.node.y})`}>
            <circle r="9.5" class="l-dot-halo" fill="none" />
            <circle r="4.5" class="l-dot" />
          </g>
        </svg>

        <div class="loop-readout" aria-hidden="true">
          <span class="num text-[10px] uppercase tracking-[0.08em] text-faint">Stage</span>
          <span class="font-display text-[2.75rem] leading-none tracking-tight text-text" data-readout>{first.no}</span>
          <span class="num text-[10px] uppercase tracking-[0.08em] text-faint">of {String(N).padStart(2, '0')}</span>
        </div>

        <div class="loop-tabs" data-tablist aria-label="Stages of the relearning loop">
          {stages.map((s) => (
            <a
              href={`#loop-${s.key}`}
              id={`loop-tab-${s.key}`}
              class:list={['loop-tab', `side-${s.side}`, s.i === 0 && 'is-active']}
              style={`left:${s.left}%;top:${s.top}%`}
              data-tab={s.i}
            >
              <span class="num tab-no">{s.no}</span>
              <span class="tab-name">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="loop-controls" data-controls>
        <button type="button" class="loop-toggle" data-toggle aria-pressed="false">
          <span class="toggle-glyph" aria-hidden="true"></span>
          <span data-toggle-text>Pause</span>
          <span class="sr-only"> auto-advance</span>
        </button>
        <span class="loop-meter" aria-hidden="true"><span class="loop-meter-fill" data-progress></span></span>
        <span class="num text-[10px] uppercase tracking-[0.08em] text-faint" data-mode>Auto · 5s</span>
      </div>
    </div>

    <ol class="loop-stages" data-panels>
      {stages.map((s) => (
        <li id={`loop-${s.key}`} class:list={['loop-stage', s.i === 0 && 'is-active']} data-panel={s.i}>
          <p class="label">
            <span class="num text-accent">{s.no}</span><span class="text-faint">/ {String(N).padStart(2, '0')}</span>
            <span class="text-faint">·</span> Stage
          </p>
          <h3 class="h-display mt-3 text-[3.25rem] md:text-[4rem]">{s.name}</h3>
          <p class="mt-3 max-w-[40ch] text-[1.0625rem] leading-relaxed text-text/85">{s.definition}</p>

          {s.entry && (
            <a href={s.entry.href} class="loop-example group">
              <span class="label text-faint">From the notebook</span>
              <span class="mt-2.5 grid grid-cols-[3.25rem_1fr_auto] items-baseline gap-x-3">
                <span class="num text-xs text-faint transition-colors group-hover:text-accent"><span class="text-accent">№</span> {s.entry.no}</span>
                <span class="h-title text-[1.02rem] transition-colors group-hover:text-accent">{s.entry.title}</span>
                <span class="ex-arrow text-faint" aria-hidden="true">→</span>
                <span class="dek col-start-2 mt-1.5 text-[0.9rem] leading-relaxed">{s.example.note}</span>
              </span>
            </a>
          )}

          <div class="loop-rule">
            <span class="num text-[11px] uppercase tracking-[0.08em] text-faint">Rule {s.no}</span>
            <p class="text-[0.95rem] leading-relaxed text-text/80">
              <strong class="font-medium text-text">{s.principle.title}.</strong> {s.principle.body}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>
<script is:inline>
  // Switch to the tab layout before first paint so there's no layout shift.
  document.querySelectorAll('[data-loop]').forEach(function (el) { el.classList.add('loop-live'); });
</script>

<style>
  .loop { container-type: inline-size; }
  .loop-grid { display: grid; gap: 2.5rem; }
  @container (min-width: 600px) {
    .loop-grid { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 2.5rem; align-items: start; }
  }
  @container (min-width: 760px) {
    .loop-grid { grid-template-columns: 340px minmax(0, 1fr); gap: 3.5rem; }
  }

  /* ── figure ── */
  .loop-figure { width: 100%; max-width: 340px; margin-inline: auto; }
  @container (min-width: 600px) { .loop-figure { position: sticky; top: 6rem; margin-inline: 0; } }
  .loop-dial { position: relative; aspect-ratio: 1; }
  .loop-svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .loop-svg * { vector-effect: non-scaling-stroke; }
  /* Dashes must stay in path space (pathLength=360); non-scaling-stroke would measure them in screen px. */
  .loop-svg .l-trail circle { vector-effect: none; }

  .l-faint { stroke: rgb(var(--line) / calc(var(--hair-a) * 1.1)); stroke-width: 1; fill: none; }
  .l-tick line { stroke: rgb(var(--line) / calc(var(--hair-a) * 1.6)); stroke-width: 1; }
  .l-tick line.major { stroke: rgb(var(--muted) / 0.55); }
  .l-ring { stroke: rgb(var(--line) / calc(var(--hair-a) * 2.4)); stroke-width: 1; }
  .l-chev { stroke: rgb(var(--muted)); stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }
  .l-trail circle { stroke: rgb(var(--accent)); stroke-width: 2; opacity: 0.2; stroke-linecap: butt; }
  .l-node-dot { fill: rgb(var(--bg)); stroke: rgb(var(--muted)); stroke-width: 1; transition: stroke 200ms; }
  .l-node-reg { stroke: rgb(var(--accent)); stroke-width: 1; opacity: 0; transform: scale(0.6); transition: opacity 250ms, transform 350ms cubic-bezier(0.22, 1, 0.36, 1); }
  .l-node.is-active .l-node-dot { stroke: rgb(var(--accent)); }
  .l-node.is-active .l-node-reg { opacity: 0.55; transform: none; }
  .l-dot { fill: rgb(var(--accent)); }
  .l-dot-halo { stroke: rgb(var(--accent)); stroke-width: 1; opacity: 0.3; }

  .loop-readout {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem;
    pointer-events: none;
  }

  /* stage labels around the dial */
  .loop-tab {
    position: absolute; display: flex; flex-direction: column; gap: 0.15rem; min-height: 40px; min-width: 40px;
    padding: 0.4rem 0.5rem; justify-content: center;
    font-family: theme('fontFamily.mono'); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgb(var(--muted)); transition: color 200ms; white-space: nowrap; text-decoration: none;
    -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .loop-tab:hover { color: rgb(var(--text)); }
  .loop-tab .tab-no { color: rgb(var(--faint)); font-size: 10px; transition: color 200ms; }
  .loop-tab.is-active { color: rgb(var(--text)); }
  .loop-tab.is-active .tab-no { color: rgb(var(--accent)); }
  .side-tl { transform: translate(-100%, -100%); text-align: right; align-items: flex-end; }
  .side-tr { transform: translate(0, -100%); }
  .side-br { transform: translate(0, 0); }
  .side-bl { transform: translate(-100%, 0); text-align: right; align-items: flex-end; }

  /* controls row: space is reserved without JS so nothing shifts */
  .loop-controls {
    display: flex; align-items: center; gap: 0.9rem; margin-top: 0.75rem; padding-top: 0.75rem;
    border-top: 1px solid rgb(var(--line) / var(--hair-a)); visibility: hidden;
  }
  .loop-live .loop-controls { visibility: visible; }
  .loop-toggle {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding-inline: 0.25rem;
    font-family: theme('fontFamily.mono'); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgb(var(--muted)); transition: color 200ms;
  }
  .loop-toggle:hover { color: rgb(var(--text)); }
  .toggle-glyph { position: relative; width: 8px; height: 9px; }
  .toggle-glyph::before, .toggle-glyph::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 2px; background: currentColor;
  }
  .toggle-glyph::before { left: 1px; }
  .toggle-glyph::after { right: 1px; }
  .loop-toggle[aria-pressed='true'] .toggle-glyph::before {
    left: 1px; width: 0; height: 0; background: none;
    border-left: 7px solid currentColor; border-top: 4.5px solid transparent; border-bottom: 4.5px solid transparent;
  }
  .loop-toggle[aria-pressed='true'] .toggle-glyph::after { display: none; }
  .loop-meter { position: relative; flex: 1; height: 1px; background: rgb(var(--line) / calc(var(--hair-a) * 1.6)); overflow: hidden; }
  .loop-meter-fill { position: absolute; inset: 0; background: rgb(var(--accent)); transform-origin: left; transform: scaleX(0); }
  .loop.is-manual .loop-toggle, .loop.is-manual .loop-meter { display: none; }

  /* ── stages: a readable list without JS ── */
  .loop-stage { padding-block: 2rem; border-top: 1px solid rgb(var(--line) / var(--hair-a)); }
  .loop-stage:first-child { border-top: 0; padding-top: 0; }
  .loop-example {
    display: block; margin-top: 1.75rem; padding-block: 1rem; border-top: 1px solid rgb(var(--line) / var(--hair-a));
    border-bottom: 1px solid rgb(var(--line) / var(--hair-a));
  }
  .loop-example .ex-arrow { transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), color 200ms; }
  .loop-example:hover .ex-arrow { transform: translateX(4px); color: rgb(var(--accent)); }
  .loop-rule { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; align-items: baseline; margin-top: 1.25rem; max-width: 52ch; }

  /* ── with JS: one panel at a time, stacked in one cell so height never jumps ── */
  .loop-live .loop-stages { display: grid; }
  .loop-live .loop-stage {
    grid-area: 1 / 1; padding: 0; border: 0;
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 280ms;
  }
  .loop-live .loop-stage.is-active {
    opacity: 1; visibility: visible; transform: none;
    transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1) 60ms, transform 420ms cubic-bezier(0.22, 1, 0.36, 1) 60ms, visibility 0s;
  }
  @container (min-width: 600px) { .loop-live .loop-stages { padding-top: 1.5rem; } }

  @media (prefers-reduced-motion: reduce) {
    .loop-live .loop-stage, .loop-live .loop-stage.is-active { transform: none; transition: none; }
    .l-node-reg { transition: none; }
  }
</style>

<script>
  import { initLoop } from './loop-client';
  document.addEventListener('astro:page-load', initLoop);
</script>
